# Copy to .env.local for local development and enter the value privately.
# Configure the production value in the Vercel project environment settings.
DATABASE_URL=

# Optional secret used to hash IPs for contact-form rate limiting.
RATE_LIMIT_SALT=

# Required in production: 32 random bytes encoded as 64 hexadecimal characters.
# Generate locally with: openssl rand -hex 32. Set the result in Vercel's server-side env.
ADMIN_LOGIN_SALT=
